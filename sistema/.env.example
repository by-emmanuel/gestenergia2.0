# GestEnergia — copie este arquivo para .env e preencha (issue #3)
# O .env NUNCA vai para o git.

# --- Flask ---
FLASK_APP=app
FLASK_DEBUG=1
# Troque por um valor aleatorio proprio (ex.: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-este-valor

# --- Porta do sistema no host ---
# Padrao 5000. No macOS o AirPlay Receiver ocupa a 5000: use 5001.
PORTA_APP=5000

# --- MySQL ---
# Rodando com Docker Compose, o host e o nome do servico: db
# Rodando com MySQL instalado na propria maquina, use: localhost
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=gestenergia
MYSQL_PASSWORD=gestenergia
MYSQL_DATABASE=gestenergia

# Banco usado pelos testes de integracao (tests/integration)
MYSQL_DATABASE_TEST=gestenergia_test

# Senha do root do MySQL (usada pelo container do banco)
MYSQL_ROOT_PASSWORD=root

# --- Modelo ---
# Diretorio onde ficam os 4 .pkl (um por setor). O arquivo de cada setor sai da
# coluna setores.arquivo_modelo, nao daqui (regra 9).
CAMINHO_MODELO=ml
